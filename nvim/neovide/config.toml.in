# Neovide 설정 틀. install.ps1이 neovim-bin 줄의 NVIM_EXE 표지를 이 PC의 진짜 nvim.exe 경로로 바꿔
# %APPDATA%\neovide\config.toml로 쓴다 (scoop shim이 아니라 실제 실행 파일: 시작마다 약 18 ms 절약).
# 글꼴은 여기에만 둔다. init.lua에서 guifont를 정하지 않는다.
# 키 이름은 Neovide 0.16.2에서 확인했다 (docs/NVIM.md 참고).

neovim-bin = '@NVIM_EXE@'
fork = true
frame = "full"
idle = true
maximized = false
no-multigrid = false
srgb = true
tabs = false
title-hidden = false
vsync = true
wsl = false

[font]
# 앞의 글꼴에 없는 글자(한글)는 다음 글꼴로 넘어간다.
normal = ["JetBrainsMono NF", "Sarasa Fixed K"]
size = 12.0
hinting = "full"
edging = "antialias"
